.title 5_stage_ring_oscillator

* 变量
* 计算哪个上升/下降沿
.PARAM RISE_FALL = 10

* PMOS/NMOS 宽长比
.PARAM nl = 40e-9
.PARAM nw = 0.000000120
.PARAM pl = 40e-9
.PARAM pw = .000000120

* 仿真温度
.PARAM temp = 25

* 电容/电阻
.PARAM res = 0
.PARAM cap = 0

* 初始化激励
.PARAM init_lin = 1.1


* 瞬时初始化
.IC
+    V(lin)=init_lin

* 仿真1ns
.TRAN 1e-9 5e-9 START=0.0

* 测量 Tphl 和 Tplh
.MEASURE TRAN Tphl TRIG V(lin) VAL=0.55 RISE=RISE_FALL 
+   TARG V(lout) VAL=0.55 FALL=RISE_FALL

.MEASURE TRAN Tplh TRIG V(lin) VAL=0.55 FALL=RISE_FALL 
+   TARG V(lout) VAL=0.55 RISE=RISE_FALL

* 测量振荡周期  T
.MEASURE TRAN T TRIG V(lout) VAL=0.55 RISE=RISE_FALL
+   TARG V(lout) VAL=0.55 RISE=RISE_FALL+1

* 上升时间
.MEASURE TRAN Tr TRIG V(lin) VAL=0.11 RISE=RISE_FALL
+   TARG V(lin) VAL=0.99 RISE=RISE_FALL

* 下降时间
.MEASURE TRAN Tf TRIG V(lin) VAL=0.99 FALL=RISE_FALL
+   TARG V(lin) VAL=0.11 FALL=RISE_FALL

* 仿真温度
.TEMP temp

.OPTION
+    ARTIST=2
+    INGOLD=2
+    PARHIER=LOCAL
+    PSF=2
.LIB "/home/apps/EDAs/libs/TSMC40LP_PDK/PDK/tn40cmsp001k3_2_0_2a/PDK/PDK/models/hspice/toplevel.l" top_tt

