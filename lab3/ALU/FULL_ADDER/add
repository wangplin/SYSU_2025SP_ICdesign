.TEMP 25
.GLOBAL vss vdd

* v0 vss 0 DC=0
* v1 vdd vss DC=1.1

.subckt inv vi vo vdd vss
XP vo vi vdd vdd p11ll_ckt w=180n l=40n $ PMOS
XN vo vi vss vss n11ll_ckt w=120n l=40n $ NMOS
.ends inv

.subckt trans_resister vin vout sel sel_bar vdd vss
XN vin sel vout vss n11ll_ckt w=120n l=40n $ NMOS
XP vin sel_bar vout vdd p11ll_ckt w=180n l=40n $ PMOS
.ends trans_resister


* P = A xor B
.subckt Propagate A B P vdd vss
XP0 B A P vdd p11ll_ckt w=180n l=40n $ PMOS
XN0 P A B_bar vss n11ll_ckt w=120n l=40n $ NMOS
Xtrans_resister_0 A P B_bar B vdd vss trans_resister
Xinv_0 B B_bar vdd vss inv
.ends Propagate


* G = A and B
.subckt Generate A B G vdd vss
XP_0 vdd A G_bar vdd p11ll_ckt w=180n l=40n $ PMOS
XP_1 vdd B G_bar vdd p11ll_ckt w=180n l=40n $ PMOS
XN_0 G_bar A net vss n11ll_ckt w=120n l=40n $ NMOS
XN_1 net B vss vss n11ll_ckt w=120n l=40n $ NMOS
Xinv_0 G_bar G vdd vss inv
.ends

.subckt OR A B O vdd vss
XP0 vdd A net vdd p11ll_ckt w=180n l=40n $ PMOS
XP1 net B O_bar vdd p11ll_ckt w=180n l=40n $ PMOS
XN0 O_bar A vss vss n11ll_ckt w=120n l=40n $ NMOS 
XN1 O_bar B vss vss n11ll_ckt w=120n l=40n $ NMOS
Xinv_0 O_bar O vdd vss inv
.ends


* Cout = G + P * Cin
.subckt Cout P G Cin Cout vdd vss
XGenerate_0 P Cin P_Cin vdd vss Generate
XOR_0 G P_Cin Cout vdd vss OR
.ends

.subckt Sout P Cin Sout vdd vss
XPropagate_0 P Cin Sout vdd vss Propagate
.ends


.subckt full_adder P G Cin Cout Sout vdd vss
XCout_0 P G Cin Cout vdd vss Cout
XSout_0 P Cin Sout vdd vss Sout
.ends


* (G_1, P_1) . (G_0, P_0) = (G_1 + P_1 * G_0, P_1 * P_0) = (G_1_0, P_1_0)
.subckt dot_product G_1 P_1 G_0 P_0 G_1_0 P_1_0 vdd vss
Xdot_product_Cout P_1 G_1 G_0 G_1_0 vdd vss Cout
Xdot_product_AND P_1 P_0 P_1_0 vdd vss Generate
.ends


.subckt ripple_carry_adder A_0 A_1 A_2 A_3 A_4 A_5 A_6 A_7 B_0 B_1 B_2 B_3 B_4 B_5 B_6 B_7 S_0 S_1 S_2 S_3 S_4 S_5 S_6 S_7 Cin Cout vdd vss

